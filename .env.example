# Environment configuration for development
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://admin:password123@mongodb:27017/collabcode?authSource=admin
REDIS_URL=redis://redis:6379
JWT_SECRET=your_jwt_secret_key_change_this_in_production
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/github/oauth/callback
CLIENT_GITHUB_CALLBACK_URL=http://localhost:3000/github/callback
# 32-byte key (base64 preferred). Example generation: openssl rand -base64 32
GITHUB_TOKEN_ENC_KEY=replace_with_32_byte_base64_key

# For Docker Compose MongoDB service
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_INITDB_DATABASE=collabcode
CLIENT_PUBLIC_API_URL=http://localhost:5000

# Worker wake-up / keep-alive (Render free tier)
# Set WORKER_URL to the base URL of your worker web service (e.g. https://my-worker.onrender.com).
# The server will ping /wake before each code execution to prevent Render cold-start timeouts,
# and ping /health every WORKER_KEEPALIVE_INTERVAL_MS ms to keep the service warm.
# WORKER_HEALTHCHECK_URL is a legacy override for the full health-check URL; prefer WORKER_URL.
WORKER_URL=https://your-worker.onrender.com
# WORKER_HEALTHCHECK_URL=https://your-worker.onrender.com/health  # legacy override
WORKER_KEEPALIVE_INTERVAL_MS=240000

# CORS — comma-separated list of allowed origins (defaults to localhost:3000-3002 if not set)
# Example for multiple origins: CORS_ORIGIN=https://app.example.com,https://staging.example.com
CORS_ORIGIN=http://localhost:3000

# Email / OTP verification (Resend — https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
# Sender address — must be a verified domain in your Resend account
# Use the default sandbox address for local testing: onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev

# Worker execution guardrails
EXECUTION_TIMEOUT_MS=10000
MAX_CODE_CHARS=200000
MAX_INPUT_CHARS=10000
MAX_FILES=50
MAX_FILE_NAME_CHARS=255
MAX_FILE_CONTENT_CHARS=200000
MAX_TOTAL_FILE_CHARS=1000000
MAX_OUTPUT_CHARS=200000
MAX_PROJECT_FILES=200
MAX_FILE_MODIFICATIONS=1000
MAX_ANALYTICS_ENTRIES=200
MAX_EXECUTION_TIMES=200
MAX_CHAT_HISTORY=1000
MAX_CHAT_MESSAGE_CHARS=2000

# Redis/BullMQ queue retention (helps small Redis plans like 30MB)
EXEC_QUEUE_KEEP_COMPLETE_AGE_SECONDS=900
EXEC_QUEUE_KEEP_COMPLETE_COUNT=100
EXEC_QUEUE_KEEP_FAILED_AGE_SECONDS=86400
EXEC_QUEUE_KEEP_FAILED_COUNT=500

LOG_LEVEL=info
ERROR_REPORT_WEBHOOK_URL=
